# macOS Apple Silicon build environment for Cassiopee (v2, sans mac-gcc-bin).
# Everything goes through the 'mac' entry of KCore/installBase.py + the Darwin
# branches of KCore/Dist.py. Sourcing: source Envs/env_Cassiopee_mac
_CASSIOPEE_ENV_FILE="${(%):-%x}"
export CASSIOPEE="$(cd "$(dirname "$_CASSIOPEE_ENV_FILE")/.." && pwd)"
export CASSIOPEE_PROD="${CASSIOPEE_PROD:-mac_i8}"
export ELSAPROD="$CASSIOPEE_PROD"
# SDKROOT: injected by Dist.getDarwinSysrootOptions() into the compile+link flags
export SDKROOT="${SDKROOT:-$(xcrun --show-sdk-path)}"
if [ -z "${CASSIOPEE_PYTHON:-}" ]; then
	if [ -x "$CASSIOPEE/../.venv/bin/python" ]; then
		export CASSIOPEE_PYTHON="$CASSIOPEE/../.venv/bin/python"
	else
		export CASSIOPEE_PYTHON="$HOME/cassiopee-venv/bin/python"
	fi
fi
export PYTHONEXE="$CASSIOPEE_PYTHON"
export PRODMODE="${PRODMODE:-1}"
export PATH="$(dirname "$CASSIOPEE_PYTHON"):$PATH"
# Homebrew GCC (versioned binaries gcc-14/gfortran-14, resolved via installBase.py)
export PATH="/opt/homebrew/opt/gcc@14/bin:/opt/homebrew/opt/open-mpi/bin:/opt/homebrew/bin:$PATH"
export PATH="$PATH:$CASSIOPEE/Dist/bin/$CASSIOPEE_PROD:$CASSIOPEE/Dist/bin/$CASSIOPEE_PROD/bin"
export PYTHONPATH="$CASSIOPEE/Dist/bin/$CASSIOPEE_PROD/lib/python3.11/site-packages:$CASSIOPEE/Dist/bin/$CASSIOPEE_PROD/lib/site-packages:$PYTHONPATH"
export DYLD_LIBRARY_PATH="/opt/homebrew/lib:/opt/homebrew/opt/gcc@14/lib/gcc/14:/opt/homebrew/opt/open-mpi/lib:$DYLD_LIBRARY_PATH"
export OMP_NUM_THREADS=8
