#!/bin/sh

if [ "$1" = "-M" ]; then
    output=
    inputs=
    while IFS= read -r line; do
        case "$line" in
            create\ *) output=${line#create } ;;
            addlib\ *)
                input=${line#addlib }
                if [ -s "$input" ] && /usr/bin/ar -t "$input" 2>/dev/null | grep -q .; then
                    inputs="${inputs}${input}\n"
                fi
                ;;
        esac
    done
    set -- /usr/bin/libtool -static -o "$output"
    while IFS= read -r input; do
        [ -n "$input" ] && set -- "$@" "$input"
    done <<EOF
$(printf '%b' "$inputs")
EOF
    if [ "$#" -eq 4 ]; then
        temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/cassiopee-ar.XXXXXX") || exit 1
        trap 'rm -rf "$temp_dir"' EXIT HUP INT TERM
        printf 'int cassiopee_empty_archive_placeholder(void) { return 0; }\n' > "$temp_dir/empty.c"
        "${CASSIOPEE_GCC_BIN:-/opt/homebrew/opt/gcc@14/bin}/gcc-14" -c "$temp_dir/empty.c" -o "$temp_dir/empty.o" || exit 1
        /usr/bin/libtool -static -o "$output" "$temp_dir/empty.o"
        result=$?
        rm -rf "$temp_dir"
        trap - EXIT HUP INT TERM
        exit "$result"
    fi
    exec "$@"
elif [ "$#" -eq 2 ] && [ "$1" = "rc" ]; then
    : > "$2"
else
    exec /usr/bin/ar "$@"
fi